<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>카페 메뉴</title>
  <style>
    body { font-family: 'Malgun Gothic', sans-serif; background: #f9fafb; color: #1f2937; margin: 0; }
    main { max-width: 560px; margin: 40px auto; padding: 0 16px; }
    h1 { text-align: center; }
    input, select { padding: 8px; border: 1px solid #e5e7eb; border-radius: 6px; }
    .add-form { display: flex; gap: 8px; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; }
    .add-form input[type="text"] { flex: 1; }
    .add-form input[type="number"] { width: 90px; }
    .add-form button { background: #92400e; color: #fff; border: none; border-radius: 6px; padding: 0 16px; cursor: pointer; }
    .category { color: #92400e; margin: 20px 0 8px; font-size: 15px; font-weight: bold; }
    .item { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 16px; margin: 6px 0; display: flex; align-items: center; gap: 10px; }
    .name { flex: 1; }
    .price { color: #92400e; font-weight: bold; }
    .edit-link { color: #6b7280; font-size: 13px; text-decoration: none; }
    .delete-btn { background: none; border: none; color: #dc2626; font-size: 13px; cursor: pointer; }
  </style>
</head>
<body>
  <main>
    <h1>카페 메뉴</h1>
    <form class="add-form" method="POST" action="/menus">
      <input type="text" name="name" maxlength="100" placeholder="메뉴 이름" required>
      <input type="number" name="price" placeholder="가격" min="0" max="2147483647" step="1" required>
      <select name="category">
        <option>커피</option>
        <option>티</option>
        <option>디저트</option>
      </select>
      <button type="submit">추가</button>
    </form>
    <% let currentCategory = ""; %>
    <% for (let i = 0; i < menus.length; i++) { %>
      <% if (menus[i].category !== currentCategory) { %>
        <% currentCategory = menus[i].category; %>
        <div class="category"><%= currentCategory %></div>
      <% } %>
      <div class="item">
        <span class="name"><%= menus[i].name %></span>
        <span class="price"><%= menus[i].price.toLocaleString() %>원</span>
        <a class="edit-link" href="/menus/<%= menus[i].id %>/edit">수정</a>
        <form method="POST" action="/menus/<%= menus[i].id %>/delete" onsubmit="return confirm('삭제할까요?');">
          <button type="submit" class="delete-btn">삭제</button>
        </form>
      </div>
    <% } %>
  </main>
</body>
</html>
